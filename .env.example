# Server Networking
HOST=0.0.0.0
PORT=8080

# Relational Database URL (persists accounts, public keys, and contact status ONLY)
# Zero message plaintext, ciphertext, history, or queues are stored in database.
DATABASE_URL=jdbc:sqlite:myth_metadata.db

# Volatile In-Memory Message Limits
VOLATILE_MESSAGE_TTL_SECONDS=60
SELF_DESTRUCT_COUNTDOWN_SECONDS=5

# Android API Base URL
# For Android Emulator connecting to host machine, use 10.0.2.2:8080
MYTH_API_BASE_URL=http://10.0.2.2:8080
MYTH_WS_BASE_URL=ws://10.0.2.2:8080/ws/v1/messaging
